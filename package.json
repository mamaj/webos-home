{
  "name": "personal-webos-home",
  "version": "0.3.3",
  "private": true,
  "description": "A cinematic, locally rendered webOS Home launcher",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node tools/bootstrap.cjs",
    "build": "node tools/bootstrap.cjs && node tools/build-home.cjs",
